---
// Ambrogio at the centre of a homelab: the services its agents use around it, the clients outside.
// The services are those of ambrogio-homelab-example; their logos belong to their owners (see README.md).
import Logo from '../brand/logo.svg';
import Tile, { type TileIcon } from './Tile.astro';
import homeAssistant from '../assets/services/home-assistant.svg?url';
import musicAssistant from '../assets/services/music-assistant.svg?url';
import openCloud from '../assets/services/opencloud.svg?url';
import openMeteo from '../assets/services/open-meteo.png';

type Service = { name: string; job: string; logo?: string; bg?: string; icon?: TileIcon; home: boolean; x: number; y: number };

// Positions in the wide diagram, around Ambrogio at (550, 290). Services in the homelab (home) sit inside its box
// (x 250-850); the LLM, which can be a cloud provider, and the public web search sit outside it.
const services: Service[] = [
	{ name: 'Home Assistant', job: 'lights and devices', logo: homeAssistant, home: true, x: 375, y: 140 },
	{ name: 'Music Assistant', job: 'music on the speakers', logo: musicAssistant, bg: '#18bcf2', home: true, x: 550, y: 95 },
	{ name: 'OpenCloud', job: 'family documents', logo: openCloud, bg: '#20434f', home: true, x: 725, y: 140 },
	{ name: 'Open-Meteo', job: 'weather', logo: openMeteo.src, bg: '#ff8800', home: true, x: 725, y: 440 },
	{ name: 'Any MCP server', job: 'your own tools', icon: 'plug', home: true, x: 375, y: 440 },
	{ name: 'Conversation memory', job: 'search past chats', icon: 'memory', home: true, x: 550, y: 470 },
	{ name: 'Your LLM', job: 'cloud or local', icon: 'llm', home: false, x: 960, y: 200 },
	{ name: 'Web search', job: 'a public service', icon: 'search', home: false, x: 960, y: 380 },
];

type Client = { name: string; icon: TileIcon; y: number; soon?: string };
const clients: Client[] = [
	{ name: 'Voice satellite', icon: 'voice', y: 110 },
	{ name: 'Web chat', icon: 'web', y: 230 },
	{ name: 'Terminal', icon: 'terminal', y: 350 },
	{ name: 'Mobile app', icon: 'mobile', y: 470, soon: 'Android and iOS, soon' },
];

const centre = { x: 550, y: 290 };
const tile = 76;
const groups = [services.filter((s) => s.home), services.filter((s) => !s.home)];
---

<figure class="homelab">
	<svg class="wide" viewBox="0 0 1060 580" role="img" aria-labelledby="homelab-title homelab-desc">
		<title id="homelab-title">Ambrogio in your homelab</title>
		<desc id="homelab-desc">
			Ambrogio runs in your homelab. Its agents use {groups[0].map((s) => s.name).join(', ')}, and outside it {groups[1].map((s) => s.name).join(' and ')}. You talk to it from {clients.map((c) => c.name.toLowerCase()).join(', ')}.
		</desc>

		<rect class="lab" x="250" y="16" width="600" height="548" rx="44" />
		<text class="lab-label" x="290" y="58">Your homelab</text>

		{services.map((s) => <line class="link" x1={centre.x} y1={centre.y} x2={s.x} y2={s.y} />)}
		{clients.map((c) => <line class:list={['link', 'client-link', { soon: c.soon }]} x1={140} y1={c.y} x2={centre.x} y2={centre.y} />)}

		{
			services.map((s) => (
				<g transform={`translate(${s.x - tile / 2} ${s.y - tile / 2})`}>
					<Tile logo={s.logo} bg={s.bg} icon={s.icon} />
					<text class="name" x={tile / 2} y={tile + 24}>{s.name}</text>
					<text class="job" x={tile / 2} y={tile + 44}>{s.job}</text>
				</g>
			))
		}

		<g transform={`translate(${centre.x - 70} ${centre.y - 70})`}>
			<Logo width="140" height="140" aria-hidden="true" />
		</g>
		<text class="centre-label" x={centre.x} y={centre.y + 100}>Ambrogio</text>

		{
			clients.map((c) => (
				<g transform={`translate(${100 - tile / 2} ${c.y - tile / 2})`}>
					<Tile icon={c.icon} round soon={!!c.soon} />
					<text class="name" x={tile / 2} y={tile + 24}>{c.name}</text>
					{c.soon && <text class="job" x={tile / 2} y={tile + 44}>{c.soon}</text>}
				</g>
			))
		}
	</svg>

	{/* Phones: the same parts stacked, from the clients down to Ambrogio and the services. */}
	<div class="narrow">
		<ul class="items clients">
			{
				clients.map((c) => (
					<li class:list={{ soon: c.soon }}>
						<svg class="mini" viewBox="0 0 76 76" aria-hidden="true"><Tile icon={c.icon} round soon={!!c.soon} /></svg>
						<span>
							<strong>{c.name}</strong>
							{c.soon && <small>{c.soon}</small>}
						</span>
					</li>
				))
			}
		</ul>
		<div class="arrow" aria-hidden="true"></div>
		<div class="box home">
			<span class="box-label">Your homelab</span>
			<div class="centre">
				<Logo class="centre-logo" width="88" height="88" aria-hidden="true" />
				<strong>Ambrogio</strong>
			</div>
			<div class="arrow" aria-hidden="true"></div>
			<ul class="items">
				{
					groups[0].map((s) => (
						<li>
							<svg class="mini" viewBox="0 0 76 76" aria-hidden="true"><Tile logo={s.logo} bg={s.bg} icon={s.icon} /></svg>
							<span>
								<strong>{s.name}</strong>
								<small>{s.job}</small>
							</span>
						</li>
					))
				}
			</ul>
		</div>
		<div class="arrow" aria-hidden="true"></div>
		<div class="box outside">
			<ul class="items">
				{
					groups[1].map((s) => (
						<li>
							<svg class="mini" viewBox="0 0 76 76" aria-hidden="true"><Tile logo={s.logo} bg={s.bg} icon={s.icon} /></svg>
							<span>
								<strong>{s.name}</strong>
								<small>{s.job}</small>
							</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</figure>

<style>
	.homelab {
		margin: 0;
	}
	.wide {
		display: block;
		width: 100%;
		height: auto;
	}
	.lab {
		fill: var(--surface);
		stroke: var(--line);
		stroke-width: 2;
	}
	.lab-label {
		font-size: 18px;
		font-weight: 800;
		fill: var(--muted);
	}
	.link {
		stroke: var(--gold);
		stroke-width: 3;
		stroke-linecap: round;
		stroke-dasharray: 2 9;
	}
	.client-link {
		stroke: var(--ambrogio-neutral-400);
	}
	.client-link.soon {
		opacity: 0.5;
	}
	/* A halo in the background colour keeps the labels readable where a link passes behind them. */
	.name,
	.job,
	.centre-label {
		paint-order: stroke;
		stroke: var(--surface);
		stroke-width: 6px;
		stroke-linejoin: round;
	}
	.name {
		font-size: 16px;
		font-weight: 800;
		text-anchor: middle;
		fill: var(--ink);
	}
	.job {
		font-size: 14px;
		text-anchor: middle;
		fill: var(--muted);
	}
	.centre-label {
		font-size: 22px;
		font-weight: 900;
		text-anchor: middle;
		fill: var(--ink);
	}

	.narrow {
		display: none;
	}
	@media (max-width: 720px) {
		.wide {
			display: none;
		}
		.narrow {
			display: flex;
			flex-direction: column;
			align-items: center;
		}
	}
	.items {
		list-style: none;
		padding: 0;
		margin: 0;
		width: 100%;
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1rem 0.75rem;
	}
	.items li {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}
	.items li.soon {
		color: var(--muted);
	}
	.mini {
		width: 2.75rem;
		height: 2.75rem;
		flex-shrink: 0;
		overflow: visible;
	}
	.items span {
		display: flex;
		flex-direction: column;
		min-width: 0;
		line-height: 1.25;
		font-size: 0.9rem;
	}
	.items small {
		color: var(--muted);
	}
	.arrow {
		width: 3px;
		height: 1.75rem;
		margin: 0.75rem 0;
		background: repeating-linear-gradient(var(--gold) 0 3px, transparent 3px 10px);
	}
	.box {
		width: 100%;
		padding: 1.25rem 1rem 1.5rem;
		border-radius: var(--ambrogio-radius-card);
	}
	.home {
		display: flex;
		flex-direction: column;
		align-items: center;
		border: 1px solid var(--line);
		background: var(--surface);
	}
	.outside {
		padding-top: 1.25rem;
		border: 1px dashed var(--ambrogio-neutral-400);
	}
	.box-label {
		align-self: flex-start;
		font-weight: 800;
		color: var(--muted);
	}
	.centre {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		font-size: 1.15rem;
		font-weight: 900;
	}
	.centre :global(.centre-logo) {
		width: 5.5rem;
		height: auto;
	}
</style>
